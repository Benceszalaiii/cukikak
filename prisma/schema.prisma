generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("NEW_DATABASE_URL")
}

enum ShirtSize {
  XXL
  XL
  L
  M
  S
  XS
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model User {
  id              String            @id @default(cuid())
  name            String?
  email           String            @unique
  emailVerified   DateTime?
  image           String?
  admin           Boolean           @default(false)
  role            UserRoles         @default(USER)
  accounts        Account[]
  sessions        Session[]
  shirtSize       ShirtSize?
  coins           Float             @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  TimelineEntries TimelineEntries[]
  attendance      TimelineEntries[] @relation("Attendance")
  questions       Questions[]
  Class           Class?            @relation(fields: [classId], references: [id])
  classId         Int?
  RSVPcreated     RSVP[]
  RSVP            RSVP[]            @relation("attendant")
  PublicImage     PublicImage[]
  clientSeed      String            @default(cuid())
  Scratch         Scratch[]
  Pin             Pin[]
}

enum UserRoles {
  USER
  CLASSMATE
  TEACHER
  STAFF
}

model TimelineEntries {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  createdBy   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  access      UserRoles
  title       String
  description String
  tags        String[]
  date        DateTime
  attendants  User[]    @relation("Attendance")
}

enum QuestionDifficulty {
  EASY
  NORMAL
  HARD
}

model Questions {
  id            Int                @id @default(autoincrement())
  createdBy     User               @relation(fields: [userId], references: [id])
  questionTitle String
  difficulty    QuestionDifficulty
  answers       String[]
  userId        String
}

model Class {
  id        Int     @id @default(autoincrement())
  name      String
  users     User[]
  teacherid String?
  shortTerm String?
}

enum RSVPType {
  MAIN
  WORKSHOP
  SHORT
  OTHER
}

model RSVP {
  id           Int      @id @default(autoincrement())
  createdBy    User     @relation(fields: [userId], references: [id])
  userId       String
  peopleNeeded Int
  attendants   User[]   @relation("attendant")
  title        String
  description  String
  type         RSVPType @default(OTHER)
  tags         String[]
  createdAt    DateTime @default(now())
  deadline     DateTime @default(now())
}

model PublicImage {
  id         String  @id @default(cuid())
  postedBy   User    @relation(fields: [userId], references: [id])
  userId     String
  publicLink String
  explicit   Boolean
}

model Scratch {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  seed       String
  nonce      Int      @default(0)
  clientSeed String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  prize      Int
  result     String[]
  scratched  Int[]
  paid       Boolean  @default(false)
}

model Pin {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  winningIndex Int
  chosenIndex  Int?
}
